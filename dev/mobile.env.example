# Append public configuration to your ignored local .env; private keys stay outside Git.
KEYCLOAK_HTTPS_ORIGIN=https://identity.example.invalid:8443
KEYCLOAK_HTTPS_BIND=127.0.0.1
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_TLS_DIRECTORY=/absolute/private/path/to/keycloak-tls
SYSKATA_OIDC_ISSUER=https://identity.example.invalid:8443/realms/syskata
