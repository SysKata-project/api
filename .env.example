# Placeholder-only values. Copy to ignored .env, chmod 600, and replace each value.
SYSKATA_DB_URL=jdbc:postgresql://localhost:5432/syskata
SYSKATA_DB_USER=syskata
SYSKATA_DB_PASSWORD=REPLACE_LOCALLY
SYSKATA_EVIDENCE_URL=jdbc:postgresql://localhost:5432/syskata_evidence
SYSKATA_EVIDENCE_USER=syskata_evidence
SYSKATA_EVIDENCE_PASSWORD=REPLACE_LOCALLY
SYSKATA_OIDC_ISSUER=http://localhost:8180/realms/syskata
# psycopg DSNs for operator scripts, not Java. Use separate least-privilege roles.
SYSKATA_OPERATIONS_DB_DSN=postgresql://REPLACE_LOCALLY
SYSKATA_OPERATIONS_EVIDENCE_DSN=postgresql://REPLACE_LOCALLY
SYSKATA_KEYCLOAK_ADMIN_TOKEN=REPLACE_LOCALLY
POSTGRES_ADMIN_PASSWORD=REPLACE_LOCALLY
KEYCLOAK_DB_PASSWORD=REPLACE_LOCALLY
KEYCLOAK_ADMIN_PASSWORD=REPLACE_LOCALLY
